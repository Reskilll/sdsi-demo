# Copy this file to `.env` and change the secrets before running in production.
PORT=4000
NODE_ENV=development

# Use a long, random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=2h

# Comma-separated list of allowed origins for CORS. Use * only for local dev.
CORS_ORIGIN=http://localhost:4000

# Default admin account created on first run / seed.
ADMIN_EMAIL=admin@school.edu
ADMIN_PASSWORD=Admin@12345
