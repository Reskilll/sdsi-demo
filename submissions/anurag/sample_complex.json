{
  "ingest":    { "duration": 3, "dependsOn": [] },
  "clean_a":  { "duration": 2, "dependsOn": ["ingest"] },
  "clean_b":  { "duration": 2, "dependsOn": ["ingest"] },
  "clean_c":  { "duration": 2, "dependsOn": ["ingest"] },
