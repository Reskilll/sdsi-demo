# Environment Configuration
# Copy this file to .env.local and fill in your values

# Node environment
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/sla_tracker

# Initial admin credentials (used by seed script only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Session secret — generate a long random string
SESSION_SECRET=replace_with_a_long_random_secret_at_least_64_chars

# Business calendar configuration
APP_TIMEZONE=Asia/Kolkata
BUSINESS_START_HOUR=9
BUSINESS_END_HOUR=18

# Auth cookie settings
SESSION_COOKIE_NAME=sla_tracker_session
COOKIE_MAX_AGE_SECONDS=86400

# Rate limiting
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000