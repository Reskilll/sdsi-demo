{
  "name": "expense-splitter-server",
  "version": "1.0.0",
  "description": "Expense Splitter API - Node.js Express + PostgreSQL",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "db:init": "psql -U postgres -d expense_splitter -f database/init.sql",
    "db:seed": "psql -U postgres -d expense_splitter -f database/seed.sql"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "pg": "^8.13.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}