{
  "name": "url-shortener",
  "private": true,
  "version": "1.0.0",
  "description": "URL shortener with analytics — Vue 3 frontend, Express + SQLite backend",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w frontend",
    "prestart": "npm run build",
    "start": "npm run start -w backend",
    "dev:api": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "test": "npm run test -w backend"
  }
}
